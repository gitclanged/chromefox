# Firefox source and build output never go in this repository.
/work/
/engine/
/obj-*/
/dist/
# Firefox source unpacked in the wrong place (it belongs in work/).
/firefox-*/

# Archives, installers and update files, including the Firefox source tarball.
*.tar.xz
*.tar.bz2
*.tar.zst
*.tar.gz
*.zip
*.7z
*.dmg
*.pkg
*.exe
*.msi
*.msix
*.deb
*.rpm
*.AppImage
*.mar

# Windows debug symbols (often over 1 GB each).
*.pdb

# Leftovers from a patch that did not apply cleanly.
*.rej
*.orig

# Packed context for Gemini (regenerated on demand)
/.context/

# Raw benchmark dumps (summaries go in perf/results/)
/perf/raw/

# Personal, machine-specific Claude Code files
CLAUDE.local.md
.claude/settings.local.json

# Python and editor noise
__pycache__/
*.pyc
.venv/
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Never commit secrets
.env
*.pem
*.p12
*.pfx
*.key
